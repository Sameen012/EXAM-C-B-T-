TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PORT=3000
JWT_SECRET=replace_with_a_secure_random_secret
ADMIN_EMAIL=admin@sacht.edu.ng
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
NODE_ENV=development

# SMTP / Welcome Email Configuration (For Gmail, generate an App Password)
# 1. Open Google Account -> Security -> Enable 2-Step Verification
# 2. Search for "App passwords" -> Create password for "CBT System"
# 3. Enter your Gmail address in SMTP_USER and the 16-character code in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SACHT CBT Team <no-reply@sacht.edu.ng>"
